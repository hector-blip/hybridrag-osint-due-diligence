# Copier ce fichier en .env puis remplir les valeurs. Ne jamais publier le fichier .env.

# Obligatoire : extraction LLM et RAG
OPENAI_API_KEY=

# Obligatoire : base de graphe Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optionnel : Google Books (augmente les quotas)
GOOGLE_API_KEY=

# Optionnel : Google Patents via SerpAPI
SERPAPI_KEY=

# Optionnel : proxy ScraperAPI pour Google Scholar
SCHOLAR_PROXY_API_KEY=
